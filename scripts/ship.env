# Configuração de deploy — fonte da verdade para a skill ship.
# Alvo único: app local, processo uvicorn via run.sh.
TARGET=local
APP_URL=http://localhost:8000
# Reinicia o app: mata o uvicorn atual (se houver) e sobe de novo em background.
DEPLOY_CMD='pkill -f "uvicorn app.main:app" 2>/dev/null; sleep 1; nohup ./run.sh >/tmp/financas-app.log 2>&1 &'
# Segundos de warm-up antes de verificar.
WARMUP_SECONDS=3
